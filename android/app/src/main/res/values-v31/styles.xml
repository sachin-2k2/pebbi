<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to Android 12+ devices during app launch -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background_solid</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_tile</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background_solid</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background_solid</item>
    </style>
</resources>
